DATABASE_URL=postgres://worksphere_app:local_app_password@localhost:5432/worksphere
OWNER_DATABASE_URL=postgres://worksphere_owner:local_owner_password@localhost:5432/worksphere
POSTGRES_PASSWORD=local_owner_password
APP_DB_PASSWORD=local_app_password
SESSION_SECRET=replace-with-at-least-32-random-characters
TOTP_ENCRYPTION_KEY=replace-with-64-hex-characters
WEB_ORIGIN=http://localhost:5173
PORT=3000
NODE_ENV=development
DEV_ONLY=true
SEED_PASSWORD=Demo-WorkSphere-2026!
# Independent production secrets (required when NODE_ENV=production):
# FILE_KEK=<64 random hex characters>
# API_KEY_PEPPER=<at least 32 random characters>
# FILE_KEK_PREVIOUS=<old KEK only during rotation>
# STORAGE_ROOT=<absolute non-web-served directory>
# OFFBOARD_EXPORT_KEY=<independent 64-hex archive key; operator commands only>
