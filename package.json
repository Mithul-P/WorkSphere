{
  "name": "worksphere",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w apps/api\" \"npm run dev -w apps/web\"",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "eslint apps scripts",
    "test": "vitest run --coverage",
    "test:db": "vitest run apps/api/tests/database.test.ts",
    "test:attacks": "vitest run apps/api/tests/attacks.test.ts",
    "test:e2e": "playwright test",
    "migrate": "npm run migrate -w apps/api",
    "seed": "npm run seed -w apps/api",
    "demo": "tsx scripts/demo.ts",
    "local": "tsx scripts/local.ts",
    "test:local": "tsx scripts/local.ts test",
    "proof:rls": "tsx --env-file=.env scripts/proof-rls.ts",
    "test:browser": "tsx scripts/local.ts browser",
    "format": "prettier --write apps scripts *.ts *.json *.md .github/workflows/*.yml docker-compose.yml",
    "db:audit": "tsx scripts/db-audit.ts",
    "tenant:offboard": "tsx scripts/offboard.ts",
    "tenant:restore": "tsx scripts/restore-tenant.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@playwright/test": "^1.51.0",
    "@types/node": "^22.13.0",
    "@types/pg": "^8.11.11",
    "@types/supertest": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.12",
    "concurrently": "^9.1.2",
    "embedded-postgres": "^16.14.0-beta.17",
    "eslint": "^9.20.0",
    "prettier": "^3.5.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0",
    "vitest": "^4.1.12"
  },
  "type": "module"
}
